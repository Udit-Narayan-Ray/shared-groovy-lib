@Library('SharedLib') _
pipeline{
    agent any
    
    parameters {
        string(name: "FRONTEND_TAG", defaultValue: '',description: "Frontend tag of image built by CI Job")
        string(name: "BACKEND_TAG", defaultValue: '', description: "Backend tag of image built by CI Job")
    }
    
    stages{
        stage('Work Environment/Space clean up'){
            steps{
                script{
                    cleanWs()
                }
            }
        }
        
        stage('Git : Code Checkout from SCM tool'){
            steps{
                script{
                    code_checkout("https://github.com/Udit-Narayan-Ray/3-tier-app-deployment.git", "main")
                }
            }
        }
        
        stage('Docker Image Verification'){
            steps{
                script{
                    echo "Frontend Image tag : ${params.FRONTEND_TAG}"
                    echo "Backend Image tag : ${params.BACKEND_TAG}"
                }
            }
        }
        stage('Update : Kubernetes Manifest file with Image tags'){
            steps{
                script{
                    dir('kubernetes'){
                        sh """
                        echo "Updating backend Yaml file with Image tag"
                        sed -i -e s/wanderlust-backend-beta.*/wanderlust-backend-beta:${params.BACKEND_TAG}/g backend.yaml
                        """
                    }
                    dir('kubernetes'){
                        sh """ 
                        echo "Updating frontend Yaml file with Image tag"
                        sed -i -e s/wanderlust-frontend-beta.*/wanderlust-frontend-beta:${params.FRONTEND_TAG}/g frontend.yaml
                        """
                    }
                }
            }
        }
        
        stage('Git : Code Update and push to GitHub project Repository'){
            steps{
                script{
                    withCredentials([gitUsernamePassword(credentialsId: "GitHub", gitToolName: 'Default')]){
                        sh """ 
                        echo "Checking Repository Status:"
                        git status
                        
                        echo "Adding changes to Git: "
                        git add .
                        
                        #Checking if any change in stages against HEAD
                        if git diff-index --quiet HEAD
                        then
                            echo "Working tree clean. Nothing to commit."
                        else
                            echo "Committing Changes:"
                            git commit -m "Updated Kubernetes manifest files"
                            echo "Pushing the Updated Code to Github Repository"
                            git push "https://github.com/Udit-Narayan-Ray/3-tier-app-deployment.git" "main"
                        fi
                        """
                    }
                }
            }
        }
    }
    post{
        success{
            script{
                emailext attachLog: true,
                from: 'unr.638@gmail.com',
                subject: "Wanderlust Application has been updated and deployed : '${currentBuild.result}'",
                body: """
                <html>
                    <body>
                        <div style="background-color: #FFA07A; padding: 10px; margin-bottom: 10px;">
                            <p style="color: black; font-weight: bold;">Project: ${env.JOB_NAME}</p>
                        </div>
                        <div style="background-color: #90EE90; padding: 10px; margin-bottom: 10px;">
                            <p style="color: black; font-weight: bold;">Build Number: ${env.BUILD_NUMBER}</p>
                        </div>
                        <div style="background-color: #87CEEB; padding: 10px; margin-bottom: 10px;">
                            <p style="color: black; font-weight: bold;">URL: ${env.BUILD_URL}</p>
                        </div>
                    </body>
                    </html>
                    """,
                to: 'unr.638@gmail.com',
                mimeType: 'text/html'
            }
        }
        failure{
            script{
                emailext attachLog: true,
                from: 'unr.638@gmail.com',
                subject: "Wanderlust Application build failed - '${currentBuild.result}'",
                body: """
                    <html>
                    <body>
                        <div style="background-color: #FFA07A; padding: 10px; margin-bottom: 10px;">
                            <p style="color: black; font-weight: bold;">Project: ${env.JOB_NAME}</p>
                        </div>
                        <div style="background-color: #90EE90; padding: 10px; margin-bottom: 10px;">
                            <p style="color: black; font-weight: bold;">Build Number: ${env.BUILD_NUMBER}</p>
                        </div>
                    </body>
                    </html>
            """,
                to: 'unr.638@gmail.com',
                mimeType: 'text/html'
            }
        }
    }
}
